# ============================================================================
# KA-POSONG MULTI-TENANT MAIL SUITE & UMANG IDENTITY ENGINE (.env.example)
# Liparola Cloud Service & Server Suite (Lesotho)
# ============================================================================

# --- 1. Host & Tailscale Funnel Configuration ---
TAILSCALE_IP=100.83.242.97
PRIMARY_MAIL_HOSTNAME=aurum-thinkpad-t440p.tail8fafd0.ts.net
DEFAULT_TENANT_DOMAIN=liparola.org

# --- 2. Rust Control Plane & RBAC Security Secrets ---
MASTER_DEVOPS_KEY=devops_master_liparola_secret_key_change_me
BRIDGE_SECRET=cf_tunnel_hmac_secret_256bit_change_me
JWT_SECRET=umang_sso_jwt_signing_secret_liparola_2026_change_me
INTERNAL_SYNC_SECRET=umang_internal_sync_secret_change_me
DATABASE_URL=sqlite:///data/control_plane.db?mode=rwc

# --- 3. Stalwart Mail Server Core Integration ---
STALWART_API_URL=http://stalwart:8080
STALWART_ADMIN_USER=admin
STALWART_ADMIN_TOKEN=stalwart_super_admin_secret_change_me
STALWART_SMTP_ADDR=stalwart:25
STALWART_SUBMISSION_ADDR=stalwart:587
STALWART_IMAP_ADDR=stalwart:143

# --- 4. Outbound Smart Host Relay (Port 587 ISP Port-25 Bypass) ---
SMTP_RELAY_HOST=smtp-relay.brevo.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=relay@liparola.org
SMTP_RELAY_PASS=replace_with_smarthost_password

# --- 5. UMANG Multi-Channel OTP Delivery Gateway (SMS + WhatsApp/AetherWA) ---
UMANG_OTP_BRIDGE_URL=http://umang-otp-bridge:3001
OTP_CHANNEL=aetherwa
FALLBACK_CHANNEL=sms
ENABLE_FALLBACK=true
STRICT_OTP_DELIVERY=false
ROUTER_IPS=192.168.8.1,192.168.10.1
ROUTER_USER=admin
ROUTER_PASS=Technomath
AETHERWA_GATEWAY_URL=http://host.docker.internal:3001
