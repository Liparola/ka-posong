# ============================================================================
# KA-POSONG MULTI-TENANT MAIL SUITE & UMANG IDENTITY ENGINE (.env.example)
# Liparola Cloud Service & Server Suite (Lesotho)
# ============================================================================
# Copy to `.env` on the target host (`chmod 600 .env`) and replace all
# `replace-me` placeholders with environment-specific credentials.
# Never commit real `.env` files or live tokens to Git.

# --- 1. Host & Tailscale Funnel Configuration ---
# Development host (`aurum-thinkpad-t440p`):
#   TAILSCALE_IP=100.83.242.97
#   PRIMARY_MAIL_HOSTNAME=aurum-thinkpad-t440p.tail8fafd0.ts.net
# Production host (`lipserver-optiplex-3040`):
#   TAILSCALE_IP=100.109.250.50
#   PRIMARY_MAIL_HOSTNAME=lipserver-optiplex-3040.tail8fafd0.ts.net
APP_ENV=development
HOST=127.0.0.1
PORT=8443
SECONDARY_PORT=0
TAILSCALE_IP=100.83.242.97
PRIMARY_MAIL_HOSTNAME=aurum-thinkpad-t440p.tail8fafd0.ts.net
DEFAULT_TENANT_DOMAIN=liparola.org

# --- 2. Rust Control Plane & RBAC Security Secrets ---
MASTER_DEVOPS_KEY=replace-me
BRIDGE_SECRET=replace-me
JWT_SECRET=replace-me
INTERNAL_SYNC_SECRET=replace-me
DATABASE_URL=sqlite:///data/control_plane.db?mode=rwc
ALLOW_DEV_OTP_PREVIEW=false
ALLOW_LOCAL_OTP_FALLBACK=false
ALLOW_DETERMINISTIC_DKIM_FALLBACK=false

# --- 3. UMANG Core Platform Integration (:3000) ---
UMANG_CORE_URL=http://127.0.0.1:3000
UMANG_TENANT_ID=tnt_ka_posong
UMANG_CLIENT_ID=umang_pk_ka_posong
UMANG_API_KEY=replace-me
UMANG_WEBHOOK_SECRET=replace-me

# --- 4. Stalwart Mail Server Core Integration ---
STALWART_API_URL=http://127.0.0.1:8080
STALWART_ADMIN_USER=admin
STALWART_ADMIN_TOKEN=replace-me
STALWART_SMTP_ADDR=127.0.0.1:2525
STALWART_SUBMISSION_ADDR=127.0.0.1:587
STALWART_IMAP_ADDR=127.0.0.1:143

# --- 5. Outbound Smart Host / Cloudflare Email Relay ---
SMTP_RELAY_HOST=smtp-relay.brevo.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=relay@liparola.org
SMTP_RELAY_PASS=replace-me
CF_API_TOKEN=replace-me

# --- 6. UMANG Multi-Channel OTP Delivery Gateway (SMS + WhatsApp/AetherWA) ---
UMANG_OTP_BRIDGE_URL=http://127.0.0.1:3001
OTP_CHANNEL=aetherwa
FALLBACK_CHANNEL=sms
ENABLE_FALLBACK=true
STRICT_OTP_DELIVERY=false
ROUTER_IPS=192.168.8.1,192.168.10.1
ROUTER_USER=admin
ROUTER_PASS=replace-me
AETHERWA_GATEWAY_URL=http://127.0.0.1:3001
